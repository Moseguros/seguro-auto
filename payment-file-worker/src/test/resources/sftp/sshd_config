# sshd_config do atmoz/sftp para os testes do worker: o servidor SFTP regista as operações em /tmp/sftp.log
# (sftp-logged.sh) e os testes contam os downloads ("open ... flags READ"). Sem ChrootDirectory (dentro do
# chroot o sftp-server não chega ao script nem ao registo): a raiz das pastas é a do utilizador (/home/demo),
# e os caminhos relativos são os mesmos do compose.
Protocol 2
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key
UseDNS no
PermitRootLogin no
X11Forwarding no
AllowTcpForwarding no
Subsystem sftp /usr/local/bin/sftp-logged.sh
ForceCommand /usr/local/bin/sftp-logged.sh
LogLevel INFO
