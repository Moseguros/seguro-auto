# sshd_config do atmoz/sftp com o registo das operações SFTP (internal-sftp -l INFO): os testes do worker
# contam os downloads ("open ... flags READ") no log do contentor (sshd -D -e escreve no stderr).
Protocol 2
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key
UseDNS no
PermitRootLogin no
X11Forwarding no
AllowTcpForwarding no
Subsystem sftp internal-sftp -l INFO
ForceCommand internal-sftp -l INFO
ChrootDirectory %h
LogLevel INFO
