{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moseguros.co.mz/schemas/payment-file-rejected.v1.json",
  "title": "PaymentFileRejected",
  "description": "Um ficheiro de movimentos rejeitado por inteiro; nenhum registo é publicado (S5-06).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId", "schemaVersion", "insurerId", "sourceId", "fileFormat", "fileName", "sha256",
    "reason", "detail", "rejectedAt"
  ],
  "properties": {
    "messageId": { "$ref": "#/$defs/sha256" },
    "schemaVersion": { "const": 1 },
    "insurerId": { "$ref": "#/$defs/uuid" },
    "sourceId": { "$ref": "#/$defs/uuid" },
    "fileFormat": { "enum": ["MEPS", "BMEPS"] },
    "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
    "sha256": { "$ref": "#/$defs/sha256" },
    "formatFileId": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/formatFileId" }]
    },
    "reason": {
      "enum": [
        "ENTITY_MISMATCH", "TRAILER_COUNT_MISMATCH", "TRAILER_TOTAL_MISMATCH", "INVALID_AMOUNT",
        "PARSE_ERROR", "ENCODING_ERROR", "MISSING_HEADER", "MISSING_TRAILER",
        "UNSUPPORTED_RECORD", "FILE_TOO_LARGE", "DUPLICATE_FILE_ID"
      ]
    },
    "detail": { "type": "string", "minLength": 1, "maxLength": 200 },
    "lineNo": { "type": ["integer", "null"], "minimum": 1 },
    "rejectedAt": { "$ref": "#/$defs/instant" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "formatFileId": {
      "description": "MEPS: A005 (AAAAMMDDS). BMEPS: <empresa>-<perfil>-<ID do ficheiro>.",
      "type": "string",
      "pattern": "^([0-9]{9}|[0-9]{3}-[0-9]{2}-[0-9]{5})$"
    }
  }
}
