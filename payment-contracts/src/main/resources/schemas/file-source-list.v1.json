{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moseguros.co.mz/schemas/file-source-list.v1.json",
  "title": "FileSourceList",
  "description": "Resposta de GET /internal/v1/payment-file-sources (S5-09): as fontes de ficheiros de movimentos, sem segredos (só referências do cofre).",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": { "type": "array", "items": { "$ref": "#/$defs/fileSourceDescriptor" } }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "directory": {
      "description": "Absoluta ou relativa, sem '..'.",
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "not": { "pattern": "(^|/)\\.\\.(/|$)" }
    },
    "fileSourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "insurerId", "version", "enabled", "entity", "fileFormat", "sftp", "secretRefs"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/uuid" },
        "insurerId": { "$ref": "#/$defs/uuid" },
        "version": { "type": "integer", "minimum": 0 },
        "enabled": { "type": "boolean" },
        "entity": { "type": "string", "pattern": "^[0-9]{5}$" },
        "fileFormat": { "enum": ["MEPS", "BMEPS"] },
        "bmepsCompanyId": { "type": ["string", "null"], "pattern": "^[0-9]{3}$" },
        "bmepsProfileId": { "type": ["string", "null"], "pattern": "^[0-9]{2}$" },
        "sftp": { "$ref": "#/$defs/sftp" },
        "secretRefs": {
          "type": "object",
          "propertyNames": { "pattern": "^sftp\\.[A-Za-z]+$" },
          "additionalProperties": { "type": "string", "pattern": "^secret/[A-Za-z0-9._/-]+$" }
        }
      },
      "if": { "properties": { "fileFormat": { "const": "BMEPS" } }, "required": ["fileFormat"] },
      "then": {
        "required": ["bmepsCompanyId", "bmepsProfileId"],
        "properties": {
          "bmepsCompanyId": { "type": "string" },
          "bmepsProfileId": { "type": "string" }
        }
      }
    },
    "sftp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "username", "authType", "inboundDir", "moveAfterProcessing", "filePattern"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 255 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string", "minLength": 1, "maxLength": 64 },
        "authType": { "enum": ["PASSWORD", "KEY"] },
        "inboundDir": { "$ref": "#/$defs/directory" },
        "moveAfterProcessing": { "type": "boolean" },
        "processedDir": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/directory" }] },
        "errorDir": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/directory" }] },
        "filePattern": { "type": "string", "minLength": 1, "maxLength": 100 },
        "hostKeyFingerprint": {
          "type": ["string", "null"],
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}=?$"
        }
      },
      "if": { "properties": { "moveAfterProcessing": { "const": true } }, "required": ["moveAfterProcessing"] },
      "then": {
        "required": ["processedDir", "errorDir"],
        "properties": {
          "processedDir": { "type": "string" },
          "errorDir": { "type": "string" }
        }
      }
    }
  }
}
