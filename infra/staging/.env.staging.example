# Variáveis de ambiente de staging (S6-08 §9). SEM VALORES: os segredos vêm do cofre de segredos do
# alojamento (ainda por decidir, modelo transversal §9) e nunca entram no Git. Os nomes são os que os
# application.yml/application-staging.yml/application-prod.yml do backend e o application.yml do
# payment-file-worker já lêem; scripts/check-env-example.sh confirma que nenhum falta.
#
# As credenciais M-Pesa e SFTP de cada seguradora NÃO entram aqui: ficam no cofre (S5-01, AGENTS.md §6).

# --- Comum ------------------------------------------------------------------------------------
# backend: staging; worker: sem perfil staging (deixar vazio)
SPRING_PROFILES_ACTIVE=
# etiqueta environment das métricas (backend e worker)
MOSEGUROS_ENVIRONMENT=staging
# porta HTTP do backend (por defeito 8080)
SERVER_PORT=

# --- Base de dados (ADR-002 e adenda; infra/README.md) ----------------------------------------
# jdbc:postgresql://<host>:5432/moseguros?sslmode=require
DB_URL=
# backend: moseguros_app_user (sem privilégios de dono); worker: moseguros_worker_user
DB_USERNAME=
DB_PASSWORD=
# dono das tabelas, só para o Flyway (backend e worker)
DB_OWNER_USERNAME=
DB_OWNER_PASSWORD=

# --- RabbitMQ 4.1 (ADR-004; utilizadores moseguros_backend e moseguros_worker) -----------------
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# --- Cofre de segredos (S5-01) -----------------------------------------------------------------
# vault (in-memory só em local/test)
MOSEGUROS_SECRETS_STORE=
VAULT_URI=
VAULT_TOKEN=

# --- Armazenamento de ficheiros (ADR-005) ------------------------------------------------------
# s3 (credenciais pela cadeia do AWS SDK: AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY ou papel da máquina)
MOSEGUROS_FILES_STORAGE=
MOSEGUROS_S3_BUCKET=
MOSEGUROS_S3_REGION=
# só para armazenamento compatível com S3 que não seja a AWS
MOSEGUROS_S3_ENDPOINT=
MOSEGUROS_S3_PATH_STYLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- SMTP --------------------------------------------------------------------------------------
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# ex.: MoSeguros <nao-responder@moseguros.co.mz>
MOSEGUROS_NOTIFICATION_EMAIL_FROM=

# --- Chaves e segredos da aplicação (cofre) ----------------------------------------------------
# PEM PKCS#8, RSA 2048 (S1-02)
MOSEGUROS_JWT_PRIVATE_KEY=
MOSEGUROS_JWT_KEY_ID=
# HMAC dos códigos OTP (S1-03)
MOSEGUROS_OTP_PEPPER=
# AES-GCM dos documentos e NUIT (CryptoService), 32 bytes em Base64
MOSEGUROS_DATA_KEY_1=
# índice cego da carta de condução (S2-03), 32 bytes em Base64, diferente da chave de cifra
MOSEGUROS_BLIND_INDEX_KEY=
# subject_hash do registo das verificações (S6-03), 32 bytes em Base64
MOSEGUROS_VERIFICATION_HASH_KEY=
# recibos de entrega dos fornecedores de SMS/WhatsApp (S1-03); vazio recusa todos os recibos
MOSEGUROS_NOTIFICATION_WEBHOOK_SECRET=

# --- Cliente de serviço do payment-file-worker (S5-09) -----------------------------------------
# backend: segredo do cliente payment-file-worker
MOSEGUROS_SERVICE_CLIENT_PAYMENT_FILE_WORKER_SECRET=
# worker: o mesmo valor
WORKER_CLIENT_SECRET=
# worker: URL interno do backend (ex.: http://backend:8080)
WORKER_BACKEND_BASE_URL=
# worker: intervalo entre leituras de cada fonte (por defeito PT60S) e pasta de trabalho
WORKER_POLL_INTERVAL=
WORKER_WORK_DIR=

# --- Primeiro administrador (S1-04) ------------------------------------------------------------
MOSEGUROS_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=
MOSEGUROS_BOOTSTRAP_PLATFORM_ADMIN_NAME=

# --- CAPTCHA (S6-03): turnstile quando houver conta; o segredo fica no cofre ------------------
MOSEGUROS_CAPTCHA_PROVIDER=
MOSEGUROS_CAPTCHA_SITE_KEY=
MOSEGUROS_CAPTCHA_ALLOWED_HOSTNAMES=

# --- Notificações (S1-03, S6-04): mocks enquanto não houver fornecedores -----------------------
# push: mock ou fcm (a credencial do FCM fica no cofre em secret/platform/fcm/service-account)
MOSEGUROS_NOTIFICATION_PUSH_PROVIDER=
MOSEGUROS_NOTIFICATION_PUSH_MOCK_URL=
MOSEGUROS_NOTIFICATION_SMS_MOCK_URL=
MOSEGUROS_NOTIFICATION_WHATSAPP_MOCK_URL=

# --- Web e proxies -----------------------------------------------------------------------------
# URL da web nos e-mails e convites (ex.: https://staging.moseguros.co.mz)
MOSEGUROS_WEB_BASE_URL=
# domínio público que vai nos QR dos certificados (S6-01); por defeito igual a MOSEGUROS_WEB_BASE_URL
MOSEGUROS_WEB_PUBLIC_BASE_URL=
# proxies cujo X-Forwarded-For é aceite (D15): o terminador TLS e o nginx da web
MOSEGUROS_WEB_TRUSTED_PROXIES=

# --- Observabilidade e limites (S6-08) ---------------------------------------------------------
# rede interna do Prometheus (fora dela /api/v1/prometheus dá 404)
MOSEGUROS_OBSERVABILITY_ALLOWED_CIDRS=
# limites por instância (deixar vazios = defeitos 60, 300 e 30); só as corridas de carga os sobem
MOSEGUROS_VERIFICATION_RATE_LIMIT_PUBLIC_PER_MINUTE=
MOSEGUROS_VERIFICATION_RATE_LIMIT_POLICE_PER_MINUTE=
MOSEGUROS_RATING_MAX_REQUESTS_PER_HOUR=
