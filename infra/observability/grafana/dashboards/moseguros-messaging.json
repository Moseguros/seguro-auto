        {
          "datasource": {
            "type": "prometheus",
            "uid": "moseguros-prometheus"
          },
          "expr": "sum by (queue) (rabbitmq_queue_messages{job=\"rabbitmq\",queue=~\".*\\\\.dlq\"})",
          "legendFormat": "{{queue}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "moseguros-prometheus"
          },
          "expr": "sum by (queue) (moseguros_payment_queue_messages{environment=~\"$environment\",queue=~\".*\\\\.dlq\"})",
          "legendFormat": "{{queue}} (backend)",
          "refId": "B"
        }
      ]
    },
