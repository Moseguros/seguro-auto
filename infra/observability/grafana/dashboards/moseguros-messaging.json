{
  "uid": "moseguros-messaging",
  "title": "MoSeguros — Mensageria e pagamentos",
  "tags": [
    "moseguros",
    "pagamentos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "moseguros-prometheus"
        },
        "query": {
          "query": "label_values(process_uptime_seconds{application=\"moseguros-backend\"}, environment)",
          "refId": "env"
        },
        "definition": "label_values(process_uptime_seconds{application=\"moseguros-backend\"}, environment)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Mensagens por fila (RabbitMQ)",
      "datasource": {
        "type": "prometheus",
        "uid": "moseguros-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "moseguros-prometheus"
          },
          "expr": "sum by (queue) (rabbitmq_queue_messages{job=\"rabbitmq\"})",
          "legendFormat": "{{queue}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "moseguros-prometheus"
          },
          "expr": "sum by (queue) (moseguros_payment_queue_messages{environment=~\"$environment\"})",
          "legendFormat": "{{queue}} (backend)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DLQ",
      "datasource": {
        "type": "prometheus",
        "uid": "moseguros-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
