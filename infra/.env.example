# Copiar para infra/.env e ajustar se for preciso. Só para desenvolvimento local.
POSTGRES_USER=moseguros
POSTGRES_PASSWORD=moseguros
POSTGRES_DB=moseguros
# Segredo dos recibos de entrega (sms-mock → backend, cabeçalho X-Webhook-Secret).
WEBHOOK_SECRET=local-webhook-secret
# RabbitMQ (S5-06): um só utilizador em local, usado também pelo backend; consola em http://localhost:15672.
RABBITMQ_DEFAULT_USER=moseguros
RABBITMQ_DEFAULT_PASS=moseguros
# Vault em modo dev (S5-06): token de raiz, só para desenvolvimento (o backend usa-o como VAULT_TOKEN).
VAULT_DEV_ROOT_TOKEN=dev-root-token
# Cliente de serviço do payment-file-worker (S5-09): o backend e o worker usam o mesmo valor.
SERVICE_CLIENT_PAYMENT_FILE_WORKER_SECRET=local-worker-secret
