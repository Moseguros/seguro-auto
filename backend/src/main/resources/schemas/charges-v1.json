{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moseguros.co.mz/schemas/charges-v1.json",
  "title": "MoSeguros - encargos da seguradora v1",
  "type": "array",
  "maxItems": 10,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["code", "labelPt", "labelEn", "type", "value"],
    "properties": {
      "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,29}$" },
      "labelPt": { "type": "string", "minLength": 1, "maxLength": 80 },
      "labelEn": { "type": "string", "minLength": 1, "maxLength": 80 },
      "type": { "enum": ["PERCENT", "FIXED"] },
      "value": true
    },
    "if": { "properties": { "type": { "const": "FIXED" } } },
    "then": { "properties": { "value": { "type": "integer", "minimum": 0, "maximum": 100000000 } } },
    "else": { "properties": { "value": { "type": "string", "pattern": "^(0|[1-9][0-9]?)(\\.[0-9]{1,4})?$" } } }
  }
}
