{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moseguros.co.mz/schemas/payment-method-bank_reference.json",
  "title": "MoSeguros - entidade e referência Ponto24 da seguradora (não secretos)",
  "description": "Entidade da seguradora na rede Ponto24, formato do ficheiro de movimentos (MEPS ou BMEPS, docs/specs/interbancos/) e servidor SFTP da seguradora onde o banco o deposita. As credenciais SFTP (sftp.password, sftp.privateKey, sftp.passphrase) não estão aqui: vão para o cofre de segredos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity", "fileFormat", "sftp"],
  "properties": {
    "entity": { "type": "string", "pattern": "^[0-9]{5}$", "description": "Entidade (5 dígitos)" },
    "fileFormat": { "type": "string", "enum": ["MEPS", "BMEPS"] },
    "bmepsCompanyId": { "type": "string", "pattern": "^[0-9]{3}$", "description": "ID da empresa no BMEPS" },
    "bmepsProfileId": { "type": "string", "pattern": "^[0-9]{2}$", "description": "ID do perfil no BMEPS" },
    "sftp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "username", "authType", "inboundDir", "moveAfterProcessing", "filePattern"],
      "properties": {
        "host": { "type": "string", "pattern": "^[A-Za-z0-9.-]{1,253}$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 22 },
        "username": { "type": "string", "minLength": 1, "maxLength": 64 },
        "authType": { "type": "string", "enum": ["PASSWORD", "KEY"] },
        "inboundDir": { "$ref": "#/$defs/directory" },
        "moveAfterProcessing": { "type": "boolean", "default": true },
        "processedDir": { "$ref": "#/$defs/directory" },
        "errorDir": { "$ref": "#/$defs/directory" },
        "filePattern": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^/\\\\]+$", "default": "*" },
        "hostKeyFingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}=?$",
          "description": "Impressão digital da chave do servidor SFTP; obrigatória para activar fora dos perfis local e test"
        }
      }
    }
  },
  "$defs": {
    "directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$",
      "description": "Começa por / ou é relativa; sem segmentos .."
    }
  }
}
